# Ignore built files
out/
node_modules/
*.vsix

# Dev-only docs (not for public repo)
DEV-README.md
INTERNAL-DEV-NOTES.md

# IDE
# .vscode/* (not .vscode/) so the negations below can un-ignore specific
# files — a bare .vscode/ prunes the whole directory from traversal before
# git ever evaluates per-file negation patterns inside it.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# OS
.DS_Store
Thumbs.db
.claude/
